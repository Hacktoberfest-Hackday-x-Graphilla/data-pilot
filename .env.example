# DEV.to API Credentials
DEVTO_API_KEY=your_dev_api_key_here
DEV_API_KEY=your_dev_api_key_here

# Model Provider Selection ("gemini" or "gemma")
AI_PROVIDER=gemini

# Google Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Gemma (OpenAI-Compatible Endpoint) Configuration
GEMMA_MODEL=gemma2-9b-it
GEMMA_API_KEY=your_gemma_api_key_here
GEMMA_API_BASE=https://api.groq.com/openai/v1
